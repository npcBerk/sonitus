# Use "mock" for UI-only local development. Production must use "database".
SONITUS_DATA_MODE=mock

DATABASE_URL=postgresql://sonitus:sonitus-local-only@localhost:5432/sonitus?schema=public
REDIS_URL=redis://localhost:6379

# Generate a unique value with at least 32 characters; never pass it in a URL.
INTERNAL_JOB_TOKEN=replace-with-a-unique-32-character-secret

SCAN_INTERVAL_MINUTES=5
SCAN_STALE_MINUTES=15
SCAN_LOCK_SECONDS=1200
METRIC_RETENTION_DAYS=30
VOLUME_BASELINE_TOLERANCE_MINUTES=90
CACHE_TTL_SECONDS=900
CATEGORY_CACHE_TTL_SECONDS=604800

COINGECKO_API_MODE=public
COINGECKO_SCAN_LIMIT=50
COINGECKO_CONCURRENCY=4
COINGECKO_TIMEOUT_MS=10000
COINGECKO_MAX_RETRIES=3
COINGECKO_API_KEY=
# Leave empty to select the correct Demo/Public or Pro host from COINGECKO_API_MODE.
COINGECKO_BASE_URL=

LOG_LEVEL=info
