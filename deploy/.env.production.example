# Copy this file to deploy/.env.production on the VPS. Never commit the real file.
DOMAIN=app.example.com
POSTGRES_PASSWORD=generate-a-long-random-password
INTERNAL_JOB_TOKEN=generate-another-random-value-at-least-32-characters

COINGECKO_API_MODE=demo
COINGECKO_API_KEY=your-key
# Leave empty to select the host from COINGECKO_API_MODE.
COINGECKO_BASE_URL=

SCAN_INTERVAL_MINUTES=5
SCAN_STALE_MINUTES=15
SCAN_LOCK_SECONDS=1200
METRIC_RETENTION_DAYS=30
VOLUME_BASELINE_TOLERANCE_MINUTES=90
CANDIDATE_RETENTION_HOURS=48
MIN_MARKET_CAP_USD=50000000
MIN_VOLUME_USD=10000000
CACHE_TTL_SECONDS=900
COINGECKO_SCAN_LIMIT=250
COINGECKO_CONCURRENCY=4
COINGECKO_TIMEOUT_MS=10000
COINGECKO_MAX_RETRIES=3

BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
LOG_LEVEL=info
