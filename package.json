{
  "name": "sonitus",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "build:netlify": "next build",
    "start": "node .next/standalone/server.js",
    "postinstall": "prisma generate",
    "preflight:production": "node scripts/production-preflight.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "SONITUS_DATA_MODE=mock tsx scripts/integration-check.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "check:netlify": "npx --yes netlify-cli@26.2.0 build --offline && node scripts/verify-netlify-build.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "worker:scan": "tsx worker/market-snapshot.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "autoprefixer": "^10.5.4",
    "bullmq": "^5.80.5",
    "ioredis": "^5.7.0",
    "next": "^16.2.10",
    "pino": "^9.14.0",
    "postcss": "^8.5.19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^3.4.17",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.2.10",
    "prisma": "^6.13.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
